{
  "id": "humanoid",
  "description": "How a humanoid character picks and blends the clips of the humanoid animation set in game (backlog M1-24, CharacterAnimator): locomotion blend space, actions triggered by ability data and combat events, crowd-control overrides, fade times.",
  "fades": {
    "blend_smoothing_s": 0.12,
    "stand_s": 0.3,
    "action_in_s": 0.1,
    "action_out_s": 0.2,
    "action_xfade_s": 0.12,
    "full_body_s": 0.2,
    "override_in_s": 0.1,
    "override_out_s": 0.25,
    "override_xfade_s": 0.15,
    "jump_in_s": 0.08,
    "jump_out_s": 0.2
  },
  "locomotion": {
    "stand": "idle",
    "combat_stand": "combat_idle",
    "directions": {
      "run": [0, 1],
      "backpedal": [0, -1],
      "strafe_right": [1, 0],
      "strafe_left": [-1, 0]
    },
    "jump": "jump",
    "moving_min_mps": 0.5,
    "teleport_min_mps": 30.0,
    "airborne_min_height_m": 0.02,
    "speed_scale": {"min": 0.6, "max": 1.4}
  },
  "combat": {
    "hostile_target_within_m": 40,
    "recent_damage_s": 5
  },
  "body_split": {
    "upper": ["spine", "chest", "neck", "head", "clavicle_l", "upperarm_l", "forearm_l", "hand_l", "clavicle_r", "upperarm_r", "forearm_r", "hand_r"],
    "lower": ["root", "pelvis", "thigh_l", "calf_l", "foot_l", "thigh_r", "calf_r", "foot_r"]
  },
  "actions": {
    "cast": {"start": "cast_start", "loop": "cast_loop", "priority": 3},
    "channel": {"loop": "channel", "priority": 3},
    "release": {"clip": "cast_release", "by_school": true, "priority": 3, "min_s": 0.25},
    "melee": {"cycle": ["attack_1", "attack_2", "attack_3"], "reset_s": 3.0, "priority": 2, "min_s": 0.35},
    "ranged": {"clip": "ranged_shot", "priority": 2, "min_s": 0.35},
    "hit": {"clip": "hit", "priority": 1, "min_damage_pct": 5, "cooldown_s": 1.5}
  },
  "ability_rules": [
    {"when": {"cast_type": ["channel"]}, "action": "channel"},
    {"when": {"cast_type": ["cast"]}, "action": "cast"},
    {"when": {"effect": ["charge"]}, "action": "melee"},
    {"when": {"school": ["physical"], "target": ["enemy"], "range": "melee"}, "action": "melee"},
    {"when": {"school": ["physical"], "target": ["enemy"], "range": "ranged"}, "action": "ranged"},
    {"when": {"school": ["physical"]}, "action": "none"},
    {"when": {}, "action": "release"}
  ],
  "ability_overrides": {
    "dread_roar": "release"
  },
  "auto_attack": "melee",
  "crowd_control": {
    "stun": "stunned",
    "incapacitate": "stunned",
    "disorient": "feared_run"
  },
  "death": "death",
  "victory": "victory",
  "rig_modifiers": {
    "look_at": {
      "bones": [
        {"bone": "chest", "share": 0.25, "yaw_limit_deg": 40, "pitch_limit_deg": 15},
        {"bone": "neck", "share": 0.45, "yaw_limit_deg": 45, "pitch_limit_deg": 20},
        {"bone": "head", "share": 1.0, "yaw_limit_deg": 55, "pitch_limit_deg": 30}
      ],
      "max_yaw_deg": 70,
      "max_pitch_up_deg": 30,
      "max_pitch_down_deg": 35,
      "give_up_deg": 120,
      "target_height_m": 1.55,
      "min_target_distance_m": 0.6,
      "marker_distance_m": 4.0,
      "turn_s": 0.15,
      "blend_in_s": 0.35,
      "blend_out_s": 0.12,
      "moving": {"share": 0.5, "max_deg": 100, "min_speed_mps": 0.5},
      "suppress": ["stunned", "feared_run", "death", "victory", "hit", "attack_1", "attack_2", "attack_3"]
    },
    "foot_ik": {
      "pelvis": "pelvis",
      "legs": [
        {"upper": "thigh_l", "lower": "calf_l", "foot": "foot_l"},
        {"upper": "thigh_r", "lower": "calf_r", "foot": "foot_r"}
      ],
      "ground_layers": [1],
      "ray_up_m": 0.5,
      "ray_down_m": 0.5,
      "max_raise_m": 0.35,
      "max_drop_m": 0.35,
      "max_pelvis_drop_m": 0.3,
      "dead_zone_m": 0.005,
      "smoothing_s": 0.06,
      "pelvis_smoothing_s": 0.1,
      "slope_tilt_max_deg": 25,
      "blend_s": 0.15,
      "foot_lock": {"enabled": true, "max_slide_m": 0.16, "max_turn_deg": 30, "release_s": 0.15},
      "suppress": ["death"]
    }
  }
}
