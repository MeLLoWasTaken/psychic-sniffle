{
  "id": "main",
  "name": "Main menu",
  "description": "Client main menu and match flow screens (backlog M1-28). Buttons route by action; the Play preset picks the local server's map, bracket and the bots filling the other slots for each spec the player can choose. Fonts and colors match the HUD (data/hud_layouts/default.json).",
  "title": "ARENA PVP",
  "subtitle": "Gallows Courtyard  ·  2v2 Arena",
  "fonts": {
    "display": {
      "file": "cinzel/Cinzel-Variable.ttf",
      "weight": 700
    },
    "text": {
      "file": "firasans/FiraSans-SemiBold.ttf"
    }
  },
  "buttons": [
    {
      "id": "play_bots",
      "label": "Play 2v2 vs bots",
      "action": "play_bots",
      "hint": "You and a bot partner against two bots, on a match server started on this machine."
    },
    {
      "id": "practice",
      "label": "Practice",
      "action": "practice",
      "hint": "The offline practice arena: the same fight without a server or an end screen."
    },
    {
      "id": "talents",
      "label": "Talents",
      "action": "talents",
      "hint": "Your talent loadouts for the chosen specialization: class tree, spec tree and PvP talents."
    },
    {
      "id": "settings",
      "label": "Settings",
      "action": "settings",
      "hint": "Your settings profile and key bindings."
    },
    {
      "id": "quit",
      "label": "Quit",
      "action": "quit",
      "hint": "Close the game."
    }
  ],
  "spec_picker": {
    "label": "Your specialization",
    "specs": [
      "warblade_carnage",
      "arcanist_rime",
      "oracle_grace"
    ],
    "default": "warblade_carnage"
  },
  "play_bots": {
    "map": "gallows_courtyard",
    "bracket": "2v2",
    "host_name": "player",
    "port_range": [
      24700,
      24799
    ],
    "comps": {
      "warblade_carnage": {
        "partner": "oracle_grace",
        "enemies": [
          "arcanist_rime",
          "oracle_grace"
        ]
      },
      "arcanist_rime": {
        "partner": "oracle_grace",
        "enemies": [
          "warblade_carnage",
          "oracle_grace"
        ]
      },
      "oracle_grace": {
        "partner": "warblade_carnage",
        "enemies": [
          "arcanist_rime",
          "oracle_grace"
        ]
      }
    },
    "bot_names": {
      "partner": "partner",
      "enemies": [
        "enemy1",
        "enemy2"
      ]
    },
    "server_start_timeout_s": 30,
    "server_silence_s": 10,
    "end_banner_s": 3.0,
    "gates_banner_s": 2.5
  },
  "settings_panel": {
    "profile": "default",
    "rows": [
      {
        "label": "Mouse sensitivity",
        "path": "mouse.sensitivity_deg_per_px",
        "suffix": "° per pixel"
      },
      {
        "label": "Invert mouse",
        "path": "mouse.invert_y"
      },
      {
        "label": "Keyboard turn speed",
        "path": "movement.keyboard_turn_deg_s",
        "suffix": "° per second"
      },
      {
        "label": "Camera distance",
        "path": "camera.default_distance_m",
        "suffix": " m"
      },
      {
        "label": "Field of view",
        "path": "camera.fov_deg",
        "suffix": "°"
      },
      {
        "label": "Interface scale",
        "path": "interface.ui_scale",
        "suffix": "×"
      },
      {
        "label": "Combat text",
        "path": "interface.combat_text"
      },
      {
        "label": "Tab target range",
        "path": "targeting.tab_range_m",
        "suffix": " m"
      }
    ],
    "keys": [
      "move_forward",
      "move_back",
      "turn_left",
      "turn_right",
      "strafe_left",
      "strafe_right",
      "target_nearest_enemy",
      "set_focus",
      "break_free"
    ]
  },
  "controls_hint": "W S move   ·   A D turn   ·   Q E strafe   ·   Right-drag steer   ·   Tab target   ·   1 – = and Shift+1 – = abilities   ·   Esc menu",
