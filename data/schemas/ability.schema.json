{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ability.schema.json",
  "title": "Ability",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "owner",
    "kit_slot",
    "school",
    "cast_type",
    "cooldown_s",
    "triggers_gcd",
    "range_m",
    "requires_los",
    "target",
    "effects",
    "icon"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "owner": {
      "type": "string",
      "description": "Class id, spec id, or 'shared' for abilities every player has (auto attack, Break Free)."
    },
    "kit_slot": {
      "enum": [
        "core",
        "burst",
        "cc",
        "interrupt",
        "defensive",
        "mobility",
        "utility",
        "passive",
        "shared"
      ],
      "description": "Slot in the ability kit template from docs/DESIGN.md."
    },
    "school": {
      "$ref": "common.schema.json#/$defs/school"
    },
    "cast_type": {
      "enum": [
        "instant",
        "cast",
        "channel",
        "passive"
      ]
    },
    "cast_time_s": {
      "type": "number",
      "minimum": 0,
      "description": "Cast bar or channel length. Required for cast and channel."
    },
    "channel_ticks": {
      "type": "integer",
      "minimum": 1
    },
    "cooldown_s": {
      "type": "number",
      "minimum": 0
    },
    "charges": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "triggers_gcd": {
      "type": "boolean"
    },
    "gcd_override_s": {
      "type": "number",
      "minimum": 0
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource",
        "amount"
      ],
      "properties": {
        "resource": {
          "$ref": "common.schema.json#/$defs/resource"
        },
        "amount": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "generates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource",
        "amount"
      ],
      "properties": {
        "resource": {
          "$ref": "common.schema.json#/$defs/resource"
        },
        "amount": {
          "type": "number"
        }
      }
    },
    "range_m": {
      "type": "number",
      "minimum": 0
    },
    "min_range_m": {
      "type": "number",
      "minimum": 0
    },
    "requires_los": {
      "type": "boolean"
    },
    "target": {
      "enum": [
        "enemy",
        "ally",
        "self",
        "any_unit",
        "ground",
        "none"
      ]
    },
    "castable_while_moving": {
      "type": "boolean",
      "default": false
    },
    "interruptible": {
      "type": "boolean",
      "default": true
    },
    "usable_while_cc": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/cc_category"
      },
      "description": "CC categories this ability can still be used under (Break Free lists them all)."
    },
    "pvp_modifier": {
      "type": "number",
      "minimum": 0,
      "default": 1.0
    },
    "effects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/effect"
      }
    },
    "vfx": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cast": {
          "type": "string"
        },
        "projectile": {
          "type": "string"
        },
        "impact": {
          "type": "string"
        },
        "aura": {
          "type": "string"
        },
        "ground": {
          "type": "string"
        }
      }
    },
    "sfx": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cast_start": {
          "type": "string"
        },
        "cast_loop": {
          "type": "string"
        },
        "release": {
          "type": "string"
        },
        "impact": {
          "type": "string"
        },
        "aura_loop": {
          "type": "string"
        }
      }
    },
    "icon": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "symbol"
      ],
      "properties": {
        "symbol": {
          "type": "string",
          "description": "Name of the symbol mesh the icon generator renders."
        },
        "image": {
          "type": "string",
          "pattern": "^[a-z0-9-]+/[a-z0-9-]+$",
          "description": "game-icons.net glyph as '<author>/<name>': game/assets/icons/game-icons/<image>.svg, rendered by tools/build_icons.py to game/assets/icons/glyphs/<image>.png. Without it the HUD draws the placeholder glyph and initials."
        },
        "school": {
          "$ref": "common.schema.json#/$defs/school"
        }
      }
    },
    "bot_hints": {
      "type": "object",
      "description": "Free-form hints for bot AI priority lists."
    },
    "usable_if": {
      "type": "object",
      "additionalProperties": false,
      "description": "Extra conditions checked when the ability is pressed.",
      "properties": {
        "target_health_below_pct": {
          "type": "number"
        },
        "target_has_aura": {
          "type": "string"
        },
        "caster_has_aura": {
          "type": "string"
        },
        "caster_not_has_aura": {
          "type": "string"
        },
        "target_cc": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Target must have a crowd-control aura of one of these categories."
        }
      }
    },
    "consumes_aura": {
      "type": "string",
      "description": "Aura removed from the caster when this ability is used (procs)."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "cast_type": {
            "enum": [
              "cast",
              "channel"
            ]
          }
        }
      },
      "then": {
        "required": [
          "cast_time_s"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "cast_type": {
            "const": "channel"
          }
        }
      },
      "then": {
        "required": [
          "channel_ticks"
        ]
      }
    }
  ],
  "$defs": {
    "effect": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "damage",
            "heal",
            "apply_aura",
            "dispel",
            "interrupt",
            "resource",
            "knockback",
            "teleport",
            "summon",
            "absorb",
            "remove_cc",
            "charge"
          ]
        },
        "base": {
          "type": "number",
          "description": "Base amount before power, crit, armor and PvP modifiers."
        },
        "power_coefficient": {
          "type": "number",
          "minimum": 0
        },
        "can_crit": {
          "type": "boolean",
          "default": true
        },
        "school": {
          "$ref": "common.schema.json#/$defs/school"
        },
        "aura": {
          "type": "string",
          "description": "Aura id for apply_aura."
        },
        "dispel_types": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/dispel_type"
          }
        },
        "dispel_count": {
          "type": "integer",
          "minimum": 1
        },
        "offensive": {
          "type": "boolean"
        },
        "school_lock_s": {
          "type": "number",
          "minimum": 0
        },
        "resource": {
          "$ref": "common.schema.json#/$defs/resource"
        },
        "amount": {
          "type": "number"
        },
        "distance_m": {
          "type": "number"
        },
        "radius_m": {
          "type": "number",
          "minimum": 0
        },
        "condition": {
          "type": "object",
          "description": "Optional condition, e.g. {\"target_health_below_pct\": 20} or {\"target_has_aura\": \"frozen\"}."
        },
        "multiplier_if": {
          "type": "object",
          "description": "Multiplier when a condition holds: {\"target_has_aura\": id, \"value\": x} or {\"target_cc\": [categories], \"value\": x}."
        },
        "affects": {
          "enum": [
            "target",
            "self",
            "enemies_in_radius",
            "allies_in_radius"
          ],
          "default": "target",
          "description": "Who the effect hits. Radius effects centre on the ability's target (or the caster for self-targeted abilities)."
        },
        "max_targets": {
          "type": "integer",
          "minimum": 1
        },
        "ticks_on": {
          "enum": [
            "complete",
            "channel_tick"
          ],
          "description": "For channels: apply on every channel tick (default) or once on completion."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "damage",
                  "heal",
                  "absorb"
                ]
              }
            }
          },
          "then": {
            "required": [
              "base"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "apply_aura"
              }
            }
          },
          "then": {
            "required": [
              "aura"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "dispel"
              }
            }
          },
          "then": {
            "required": [
              "dispel_types"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "interrupt"
              }
            }
          },
          "then": {
            "required": [
              "school_lock_s"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "resource"
              }
            }
          },
          "then": {
            "required": [
              "resource",
              "amount"
            ]
          }
        }
      ]
    }
  }
}
