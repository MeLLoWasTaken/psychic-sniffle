{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "appearance_options.schema.json",
 "title": "Appearance option set",
 "description": "One kind of character creator choice (backlog G-02): face presets, hair styles, beards, skin tones, hair colours, eye colours, markings (scars and war paint). Cosmetic only (docs/DESIGN.md, Appearance and armor customization).",
 "type": "object",
 "required": ["id", "kind", "name", "options"],
 "additionalProperties": false,
 "properties": {
  "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
  "kind": {"enum": ["faces", "hair", "beards", "skin_tones", "hair_colors", "eye_colors", "markings"]},
  "name": {"type": "string"},
  "description": {"type": "string"},
  "options": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": ["id", "name"],
    "additionalProperties": false,
    "properties": {
     "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
     "name": {"type": "string"},
     "body_types": {"type": "array", "items": {"enum": ["male", "female"]}, "minItems": 1},
     "color": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"},
     "params": {"type": "object", "additionalProperties": {"type": "number"}}
    }
   }
  }
 }
}
