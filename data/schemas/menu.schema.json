{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "menu.schema.json",
  "title": "Client menu",
  "description": "Main menu buttons, the spec picker, the 'Play vs bots' preset (map, bracket, bot comps per player spec, match flow timings), the settings panel rows, and the match flow text, fonts and colors (backlog M1-28).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "title",
    "fonts",
    "buttons",
    "spec_picker",
    "play_bots",
    "text",
    "scoreboard_columns",
    "style"
  ],
  "$defs": {
    "color": {
      "type": "string",
      "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
    },
    "play_preset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "map",
        "bracket",
        "host_name",
        "port_range",
        "comps",
        "bot_names",
        "server_start_timeout_s",
        "end_banner_s",
        "server_silence_s",
        "gates_banner_s"
      ],
      "properties": {
        "map": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "bracket": {
          "enum": [
            "1v1",
            "2v2",
            "3v3"
          ]
        },
        "host_name": {
          "type": "string",
          "minLength": 1,
          "description": "The player's client name on the server (the server's --host)"
        },
        "port_range": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1024,
            "maximum": 65535
          },
          "minItems": 2,
          "maxItems": 2
        },
        "comps": {
          "type": "object",
          "description": "Player spec -> the bots' specs: one partner per ally slot and the enemy team",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "allies",
              "enemies"
            ],
            "properties": {
              "enemies": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "common.schema.json#/$defs/id"
                }
              },
              "allies": {
                "type": "array",
                "items": {
                  "$ref": "common.schema.json#/$defs/id"
                },
                "maxItems": 2,
                "description": "The bots on the player's team (bracket size minus one)."
              }
            }
          }
        },
        "bot_names": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "allies",
            "enemies"
          ],
          "properties": {
            "enemies": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "allies": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "server_start_timeout_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "end_banner_s": {
          "type": "number",
          "minimum": 0,
          "description": "Seconds the Victory/Defeat banner shows over the arena before the end screen"
        },
        "prep_s": {
          "type": "number",
          "minimum": 0,
          "description": "Preparation phase length for these matches; omitted = the tuning's arena.prep_phase_s"
        },
        "server_silence_s": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "The client leaves (and shows the failure screen) when the server sends nothing for this long"
        },
        "gates_banner_s": {
          "type": "number",
          "minimum": 0,
          "description": "Seconds the 'gates are open' banner shows after the gates open"
        }
      }
    }
  },
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "subtitle": {
      "type": "string"
    },
    "fonts": {
      "type": "object",
      "description": "Typefaces, the same as the HUD's: 'display' for titles, banners and the outcome, 'text' for buttons and body text. file is under game/assets/fonts; weight picks an instance of a variable font.",
      "required": [
        "display",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "display": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "file"
          ],
          "properties": {
            "file": {
              "type": "string",
              "pattern": "^[a-z0-9_]+/[A-Za-z0-9_.-]+\\.(ttf|otf)$"
            },
            "weight": {
              "type": "integer",
              "minimum": 100,
              "maximum": 900
            }
          }
        },
        "text": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "file"
          ],
          "properties": {
            "file": {
              "type": "string",
              "pattern": "^[a-z0-9_]+/[A-Za-z0-9_.-]+\\.(ttf|otf)$"
            },
            "weight": {
              "type": "integer",
              "minimum": 100,
              "maximum": 900
            }
          }
        }
      }
    },
    "buttons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "action"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "enum": [
              "play_bots",
              "practice",
              "settings",
              "quit",
              "talents",
              "play_1v1",
              "play_3v3"
            ],
            "description": "What the button does; the client routes each action (GameFlow)"
          },
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "hint": {
            "type": "string"
          },
          "row": {
            "type": "string",
            "description": "Buttons with the same row id sit side by side in one row."
          }
        }
      }
    },
    "spec_picker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "specs",
        "default"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "specs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "uniqueItems": true
        },
        "default": {
          "$ref": "common.schema.json#/$defs/id"
        }
      }
    },
    "play_bots": {
      "$ref": "#/$defs/play_preset"
    },
    "controls_hint": {
      "type": "string"
    },
    "text": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "scoreboard_columns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "enum": [
              "damage",
              "healing",
              "kills",
              "interrupts",
              "deaths"
            ]
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "style": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/color"
      }
    },
    "play_1v1": {
      "$ref": "#/$defs/play_preset"
    },
    "play_3v3": {
      "$ref": "#/$defs/play_preset"
    },
    "settings_screen": {
      "type": "object",
      "description": "The settings screen (M2-13): pages of rows, each bound to a settings path.",
      "required": [
        "pages"
      ],
      "properties": {
        "pages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "rows"
            ],
            "properties": {
              "id": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "label": {
                "type": "string"
              },
              "rows": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "label",
                    "type"
                  ],
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    },
                    "type": {
                      "enum": [
                        "slider",
                        "toggle",
                        "choice",
                        "device",
                        "note",
                        "keybinds"
                      ]
                    },
                    "min": {
                      "type": "number"
                    },
                    "max": {
                      "type": "number"
                    },
                    "step": {
                      "type": "number"
                    },
                    "suffix": {
                      "type": "string"
                    },
                    "choices": {
                      "type": "array"
                    },
                    "labels": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "text": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
