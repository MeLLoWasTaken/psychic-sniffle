{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "class.schema.json",
  "title": "Class",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "armor", "color", "specs", "class_tree"],
  "properties": {
    "id": {"$ref": "common.schema.json#/$defs/id"},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "armor": {"$ref": "common.schema.json#/$defs/armor"},
    "color": {"$ref": "common.schema.json#/$defs/hex_color", "description": "Class color used on nameplates and frames."},
    "specs": {"type": "array", "items": {"type": "string"}, "minItems": 1, "maxItems": 3},
    "class_tree": {"type": "string", "description": "Talent tree id of kind 'class'."},
    "shared_abilities": {"type": "array", "items": {"type": "string"}, "description": "Abilities every spec of this class has."}
  }
}
