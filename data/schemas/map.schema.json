{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "map.schema.json",
  "title": "Map",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "mode", "brackets", "size_m", "scene", "lighting_preset", "spawns"],
  "properties": {
    "id": {"$ref": "common.schema.json#/$defs/id"},
    "name": {"type": "string"},
    "description": {"type": "string"},
    "mode": {"enum": ["arena", "capture_the_flag", "resource_control"]},
    "brackets": {"type": "array", "items": {"enum": ["1v1", "2v2", "3v3", "10v10"]}, "minItems": 1},
    "size_m": {"type": "number", "minimum": 1},
    "scene": {"type": "string", "description": "res:// path of the Godot scene."},
    "lighting_preset": {"type": "string", "description": "Shared with Blender preview renders."},
    "twist": {"type": "string"},
    "spawns": {
      "type": "object",
      "additionalProperties": false,
      "required": ["team_a", "team_b"],
      "properties": {
        "team_a": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/vec3"}, "minItems": 1},
        "team_b": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/vec3"}, "minItems": 1}
      }
    },
    "status": {"$ref": "common.schema.json#/$defs/status"}
  }
}
