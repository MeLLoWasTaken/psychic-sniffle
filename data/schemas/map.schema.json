{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "map.schema.json",
  "title": "Map",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "mode",
    "brackets",
    "size_m",
    "scene",
    "lighting_preset",
    "spawns",
    "bounds_half_m",
    "colliders"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "mode": {
      "enum": [
        "arena",
        "capture_the_flag",
        "resource_control"
      ]
    },
    "brackets": {
      "type": "array",
      "items": {
        "enum": [
          "1v1",
          "2v2",
          "3v3",
          "10v10"
        ]
      },
      "minItems": 1
    },
    "size_m": {
      "type": "number",
      "minimum": 1
    },
    "scene": {
      "type": "string",
      "description": "res:// path of the Godot scene."
    },
    "lighting_preset": {
      "type": "string",
      "description": "Shared with Blender preview renders."
    },
    "twist": {
      "type": "string",
      "description": "One line describing the map's twist (loading screen, codex); the rules are in twists."
    },
    "twists": {
      "type": "array",
      "maxItems": 3,
      "description": "Timed map events on match time (game/core/arena_twists.gd, M2-16). docs/DESIGN.md: each map has one twist.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "at_s",
          "text"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "type": {
            "enum": [
              "collapse"
            ],
            "description": "collapse: the colliders with `tags` are gone from at_s on (movement, line of sight, camera), and a wreck lies where they stood."
          },
          "at_s": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "Seconds of match time (after the gates open)."
          },
          "warn_s": {
            "type": "number",
            "minimum": 0,
            "description": "A warning this many seconds before (0: none)."
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "description": "collapse: collider tags taken away."
          },
          "warn_text": {
            "type": "string"
          },
          "text": {
            "type": "string",
            "description": "The banner and event-text line when it happens."
          },
          "warn_sound": {
            "type": "string",
            "description": "Sound id (data/sounds) for the warning."
          },
          "sound": {
            "type": "string",
            "description": "Sound id (data/sounds) when it happens."
          }
        }
      }
    },
    "spawns": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "team_a",
        "team_b"
      ],
      "properties": {
        "team_a": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/vec3"
          },
          "minItems": 1
        },
        "team_b": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/vec3"
          },
          "minItems": 1
        }
      }
    },
    "status": {
      "$ref": "common.schema.json#/$defs/status"
    },
    "bounds_half_m": {
      "type": "number",
      "minimum": 1,
      "description": "Players are kept inside a square of this half-size around the origin (x and z)."
    },
    "colliders": {
      "type": "array",
      "description": "Static blockers used by movement and line of sight. Coordinates are x, z on the ground plane; y is up.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "blocks_los"
        ],
        "properties": {
          "type": {
            "enum": [
              "circle",
              "box"
            ]
          },
          "center": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "radius": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "min": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "max": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "height": {
            "type": "number",
            "default": 4
          },
          "blocks_los": {
            "type": "boolean"
          },
          "gate": {
            "type": "boolean",
            "description": "Gate: blocks only during the preparation phase, then opens."
          },
          "tag": {
            "enum": [
              "pillar",
              "wall",
              "gate",
              "gallows",
              "prop"
            ],
            "description": "What the blocker is, so the map builder picks the right greybox or art-kit piece."
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "circle"
                }
              }
            },
            "then": {
              "required": [
                "center",
                "radius"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "box"
                }
              }
            },
            "then": {
              "required": [
                "min",
                "max"
              ]
            }
          }
        ]
      }
    },
    "kit": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$",
      "description": "Environment kit (game/assets/kits/<kit>/<kit>_<piece>.glb) that dresses the colliders. Without it the map builds as greybox."
    },
    "decor": {
      "type": "array",
      "description": "Decoration with no collision: braziers, banners, props, turrets. Props must sit where players rarely stand (against walls, in corners) and never block sightlines: anything that should block is a collider instead.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "piece",
          "pos"
        ],
        "properties": {
          "piece": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$",
            "description": "Kit piece name, e.g. brazier or banner_crimson."
          },
          "pos": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2,
            "description": "x, z on the ground plane."
          },
          "y": {
            "type": "number",
            "default": 0
          },
          "yaw_deg": {
            "type": "number",
            "default": 0,
            "description": "Rotation about the vertical axis; 0 faces +z."
          },
          "light": {
            "type": "boolean",
            "default": false,
            "description": "Add a warm fire light (braziers)."
          },
          "effect": {
            "$ref": "common.schema.json#/$defs/id",
            "description": "Looping effect on the piece (data/ambient_effects/<id>.json), e.g. brazier_fire."
          },
          "scale": {
            "type": "number",
            "exclusiveMinimum": 0,
            "default": 1
          }
        }
      }
    },
    "dressing": {
      "type": "object",
      "additionalProperties": false,
      "description": "Visual dressing of the kit (backlog F-05). Nothing here adds collision or changes gameplay.",
      "properties": {
        "wall_top": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "walk": {
              "type": "string",
              "pattern": "^[a-z0-9_]+$",
              "description": "Kit piece paving the top of wall blocks (default floor_tile)."
            },
            "parapet": {
              "type": "string",
              "pattern": "^[a-z0-9_]+$",
              "description": "Kit piece crowning every facade segment (a crenellated rampart)."
            },
            "outer_facades": {
              "type": "boolean",
              "default": false,
              "description": "Face the outside of the walls along the bounds too."
            },
            "outer_wall": {
              "type": "string",
              "pattern": "^[a-z0-9_]+$",
              "description": "Facade piece for the outside of the walls (default wall); a cheaper one suits faces seen only from afar."
            }
          }
        },
        "gatehouse": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "piece"
          ],
          "description": "A gatehouse on the wall top over each gate; it must hide the raised portcullis.",
          "properties": {
            "piece": {
              "type": "string",
              "pattern": "^[a-z0-9_]+$"
            },
            "front_m": {
              "type": "number",
              "minimum": 0,
              "description": "Distance from the piece's origin to its front face, which lines up with the gate's courtyard face."
            },
            "gate_width_m": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Gate width the piece is built for; it is stretched to other widths."
            }
          }
        },
        "variants": {
          "type": "object",
          "description": "Kit piece -> {variant piece: weight}: repeated pieces are drawn from these at random.",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "number",
              "minimum": 0
            },
            "propertyNames": {
              "pattern": "^[a-z0-9_]+$"
            }
          },
          "propertyNames": {
            "pattern": "^[a-z0-9_]+$"
          }
        },
        "floor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "grime": {
              "type": "object",
              "additionalProperties": false,
              "description": "Darker floor along every wall base and around pillars and the gallows (decals).",
              "properties": {
                "color": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "minItems": 3,
                  "maxItems": 3
                },
                "alpha": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "width_m": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "minItems": 2,
                  "maxItems": 2
                }
              }
            },
            "puddles": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "pos"
                ],
                "properties": {
                  "pos": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 2,
                    "maxItems": 2
                  },
                  "size_m": {
                    "type": "array",
                    "items": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "minItems": 2,
                    "maxItems": 2
                  },
                  "yaw_deg": {
                    "type": "number"
                  },
                  "seed": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            },
            "puddle_color": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "minItems": 3,
              "maxItems": 3
            },
            "puddle_alpha": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "stains": {
              "type": "array",
              "description": "Broad, faint darker patches across the open floor (decals).",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "pos"
                ],
                "properties": {
                  "pos": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 2,
                    "maxItems": 2
                  },
                  "size_m": {
                    "type": "array",
                    "items": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "minItems": 2,
                    "maxItems": 2
                  },
                  "yaw_deg": {
                    "type": "number"
                  },
                  "seed": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "alpha": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              }
            },
            "stain_color": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "minItems": 3,
              "maxItems": 3
            }
          }
        },
        "skyline": {
          "type": "object",
          "additionalProperties": false,
          "description": "Silhouettes beyond the walls: no collision, no shadows; every piece stands outside the bounds.",
          "properties": {
            "ground": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "color": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "minItems": 3,
                  "maxItems": 3
                },
                "size_m": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "y": {
                  "type": "number"
                }
              }
            },
            "pieces": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "piece",
                  "pos"
                ],
                "properties": {
                  "piece": {
                    "type": "string",
                    "pattern": "^[a-z0-9_]+$"
                  },
                  "pos": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 2,
                    "maxItems": 2
                  },
                  "y": {
                    "type": "number"
                  },
                  "yaw_deg": {
                    "type": "number"
                  },
                  "scale": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                }
              }
            }
          }
        }
      }
    },
    "pickups": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "minItems": 3,
        "maxItems": 3
      },
      "description": "Spots of the regeneration pickups ([x, y, z]); needed when the map hosts a bracket in tuning arena.pickup_brackets."
    }
  }
}
