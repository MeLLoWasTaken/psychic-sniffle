{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "capture.schema.json",
  "title": "Fitted motion capture",
  "description": "Generated by tools/blender/build_capture.py from data/capture_sources/<id>.json; do not edit. Term values (degrees; root in leg lengths) sampled evenly over the clip's phase, first to last sample inclusive (a loop's last sample equals its first).",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "file", "loop", "samples", "channels"],
  "properties": {
    "id": {"$ref": "common.schema.json#/$defs/id"},
    "description": {"type": "string"},
    "file": {"type": "string"},
    "loop": {"type": "boolean"},
    "source_frames": {"type": "array", "items": {"type": "integer"}},
    "source_fps": {"type": "number"},
    "duration_s": {"type": "number"},
    "samples": {"type": "integer", "minimum": 2},
    "leg_units": {"type": "number"},
    "channels": {
      "type": "object",
      "propertyNames": {"pattern": "^(root|pelvis|spine|chest|neck|head|clavicle_[lr]|upperarm_[lr]|forearm_[lr]|hand_[lr]|thigh_[lr]|calf_[lr]|foot_[lr])$"},
      "additionalProperties": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "number"}}}
    }
  }
}
